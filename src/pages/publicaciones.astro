const publicacionesOrdenadas = [...publicaciones].sort((a, b) => {
	const anioA = a.anio ?? -Infinity;
	const anioB = b.anio ?? -Infinity;
	if (anioA !== anioB) {
		return anioB - anioA;
	}

	const citasA = a.citadoPor ?? -Infinity;
	const citasB = b.citadoPor ?? -Infinity;
	if (citasA !== citasB) {
		return citasB - citasA;
	}

	return a.titulo.localeCompare(b.titulo);
});

---

<Layout title="Publicaciones | LED&T">
	<main class="bg-slate-50 min-h-[65vh]">
		<section class="bg-linear-to-br from-slate-50 via-white to-cyan-50/40 py-12 md:py-16 border-b border-slate-200">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<nav class="text-xs text-slate-500 mb-4">
					<a href="/" class="hover:text-blue-700">Inicio</a>
					<span class="mx-2">/</span>
					<span class="text-slate-700">Publicaciones</span>
				</nav>
				<p class="text-cyan-700 font-mono text-xs uppercase tracking-widest mb-3">Produccion cientifica</p>
				<h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-slate-900 mb-4">Publicaciones de integrantes del LED&T</h1>
				<p class="text-slate-600 text-base sm:text-lg max-w-3xl leading-relaxed">
					Primera carga de trabajos en el area de procesamiento digital de senales, PLC e IPTV.
				</p>
				<p class="text-xs text-slate-500 mt-3">{publicacionesOrdenadas.length} registros</p>
			</div>
		</section>

		<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-12">
			<div class="hidden md:block overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm">
				<table class="min-w-full text-sm">
					<thead class="bg-slate-100 text-slate-700">
						<tr>
							<th class="text-left px-4 py-3 font-semibold">Titulo</th>
							<th class="text-left px-4 py-3 font-semibold">Autores</th>
							<th class="text-left px-4 py-3 font-semibold">Fuente</th>
							<th class="text-left px-4 py-3 font-semibold">Citado por</th>
							<th class="text-left px-4 py-3 font-semibold">Anio</th>
						</tr>
					</thead>
					<tbody>
						{publicacionesOrdenadas.map((pub) => (
							<tr class="border-t border-slate-100 align-top hover:bg-slate-50/70">
								<td class="px-4 py-3 text-slate-900 font-medium leading-relaxed">{pub.titulo}</td>
								<td class="px-4 py-3 text-slate-700 leading-relaxed">{pub.autores}</td>
								<td class="px-4 py-3 text-slate-600 leading-relaxed">{pub.medio}</td>
								<td class="px-4 py-3 text-slate-700">{pub.citadoPor ?? '-'}</td>
								<td class="px-4 py-3 text-slate-700">{pub.anio ?? '-'}</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>

			<div class="md:hidden space-y-4">
				{publicacionesOrdenadas.map((pub) => (
					<article class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
						<h2 class="text-base font-semibold text-slate-900 leading-snug mb-2">{pub.titulo}</h2>
						<p class="text-sm text-slate-700 mb-2"><strong>Autores:</strong> {pub.autores}</p>
						<p class="text-sm text-slate-600 mb-3"><strong>Fuente:</strong> {pub.medio}</p>
						<div class="flex items-center gap-4 text-xs text-slate-600">
							<span><strong>Citado por:</strong> {pub.citadoPor ?? '-'}</span>
							<span><strong>Anio:</strong> {pub.anio ?? '-'}</span>
						</div>
					</article>
				))}
			</div>

			<div class="mt-8">
				<a href="/" class="inline-flex items-center gap-2 px-5 py-3 rounded-md bg-primario text-white font-semibold hover:bg-primario-oscuro transition-colors">
					Volver al inicio
				</a>
			</div>
		</section>
	</main>
</Layout>
