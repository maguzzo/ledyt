---
import Layout from '../../layouts/Layout.astro';


const oportunidad = {
	etiqueta: 'Oportunidades abiertas',
	titulo: 'Caminos para sumarte al LED&T',
	proyecto: 'Si te interesa colaborar, aprender o desarrollar un tema propio, escribinos y vemos alternativas según tu perfil y la disponibilidad del laboratorio.',
	contacto: 'm.guzzo@unsj.edu.ar',
	contactoLabel: 'Contacto directo',
	accion: 'Escribir al laboratorio',
	verContacto: 'Ir a contacto',
};

const lineas = [
	{
		nombre: 'Proyectos integradores',
		resumen: 'Trabajo aplicado sobre hardware, software y validacion con problemas reales del laboratorio.',
		perfil: 'Ideal para estudiantes que quieren sumar experiencia tecnica concreta.',
		items: [
			'Participacion en tareas reales de diseno, prueba y documentacion',
			'Acompanamiento del equipo docente en una linea concreta de trabajo',
			'Posibilidad de integrar el resultado a una materia o proyecto mayor',
		],
	},
	{
		nombre: 'Adscripciones y colaboraciones',
		resumen: 'Tareas de apoyo en laboratorio, ordenamiento de material y participacion en ensayos.',
		perfil: 'Ideal para quienes quieren empezar a trabajar con el equipo.',
		items: [
			'Ingreso gradual al flujo de trabajo del LED&T',
			'Aprendizaje de herramientas, instrumentacion y buenas practicas',
			'Posibilidad de extender la colaboracion si hay encaje tecnico',
		],
	},
	{
		nombre: 'Tesis y trabajos finales',
		resumen: 'Temas de investigacion para profundizar en un area tecnica con acompañamiento.',
		perfil: 'Ideal para quienes buscan una instancia final con contenido propio.',
		items: [
			'Definicion de un problema acotado y viable',
			'Acompañamiento para delimitar alcance y cronograma',
			'Posibilidad de articular con proyectos del laboratorio',
		],
	},
];

const equipo = [
	{
		nombre: 'Dr. Ing. Martin A. Guzzo',
		rol: 'Director del proyecto',
		expertise: 'Arquitecturas FPGA/SoC, sistemas digitales de alta velocidad, comunicaciones satelitales y estimacion de canal LDPC.',
	},
	{
		nombre: 'Dr. Ing. Gabriel E. Canadas',
		rol: 'Asesor - PCB y SoC',
		expertise: 'Diseno de hardware, sistemas inalambricos, integracion de sensores y validacion de prototipos electronicos.',
	},
	{
		nombre: 'Dr. Ing. Eugenio C. Orosco',
		rol: 'Asesor - Firmware',
		expertise: 'Sistemas embebidos, procesamiento de senales, firmware de microcontroladores y supervision de hardware.',
	},
];

const herramientas = [
	'AMD-Xilinx Vivado, Vitis y Vitis HLS con licencias universitarias',
	'2 x AMD-Xilinx RFSoC 4x2 para procesamiento SDR de alto rendimiento',
	'2 x ADALM-Pluto para prototipado rapido y banco de pruebas',
	'GNU Radio 3.10, gr-dvbs2rx y gr-iio sobre Linux',
	'PetaLinux, Yocto, libcsp y drivers IIO de Analog Devices',
	'Instrumentacion RF Aaronia y OWON, medidores de ROE y antenas log-periodicas',
	'Laboratorio SMD completo con soldadura BGA, microscopio-camara y osciloscopios',
	'Repos privados en GitHub y documentacion ECSS-style',
];

const beneficios = [
	'Contacto directo con docentes investigadores del laboratorio.',
	'Posibilidad de encontrar una modalidad que encaje con tu perfil y tu disponibilidad.',
	'Insercion en un entorno de trabajo con proyectos reales y seguimiento tecnico.',
	'Orientacion para definir el mejor camino: proyecto, adscripcion, tesis o colaboracion puntual.',
];

const pasos = [
	{
		paso: '1. Escribinos',
		detalle: 'Enviá un mail breve con tu interes, tu carrera y el tipo de experiencia que estas buscando.',
	},
	{
		paso: '2. Contanos tu perfil',
		detalle: 'Con esa informacion vemos si encaja mejor un proyecto integrador, una adscripcion, una tesis o una colaboracion puntual.',
	},
	{
		paso: '3. Acordamos el siguiente paso',
		detalle: 'Si hay una oportunidad adecuada, coordinamos una reunion breve para definir alternativas.',
	},
];
---

<Layout title="Oportunidades | LED&T">
	<main class="min-h-[65vh] bg-slate-50">
		<section class="relative overflow-hidden bg-linear-to-br from-slate-50 via-white to-cyan-50/40 border-b border-slate-200">
			<div class="absolute top-0 right-0 w-96 h-96 bg-cyan-100/30 rounded-full blur-3xl z-0"></div>
			<div class="absolute bottom-0 left-0 w-80 h-80 bg-blue-100/30 rounded-full blur-3xl z-0"></div>

			<div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
				<div class="grid lg:grid-cols-12 gap-10 items-center">
					<div class="lg:col-span-7">
						<p class="inline-flex items-center gap-2 text-sm font-semibold text-cyan-700 mb-5 tracking-wide uppercase">
							<span class="w-8 h-px bg-cyan-600"></span>
							{oportunidad.etiqueta}
						</p>
						<h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-slate-900 leading-tight mb-6">
							{oportunidad.titulo}
						</h1>
						<p class="text-lg text-slate-600 leading-relaxed max-w-3xl mb-6">
							{oportunidad.proyecto}
						</p>

						<div class="flex flex-wrap gap-3 mb-8">
							<a href={`mailto:${oportunidad.contacto}?subject=Consulta%20de%20oportunidades%20-%20LED%26T`} class="inline-flex items-center gap-2 px-6 py-3 bg-blue-700 text-white font-semibold rounded-lg hover:bg-blue-800 transition-colors shadow-md">
								{oportunidad.accion}
							</a>
							<a href="/contacto" class="inline-flex items-center gap-2 px-6 py-3 border border-slate-300 text-slate-800 font-semibold rounded-lg hover:bg-slate-100 transition-colors">
								{oportunidad.verContacto}
							</a>
						</div>

						<div class="flex flex-wrap gap-x-8 gap-y-3 text-sm text-slate-600">
							<span><strong class="text-slate-900">{oportunidad.contactoLabel}:</strong> <a href={`mailto:${oportunidad.contacto}`} class="text-blue-700 hover:underline">{oportunidad.contacto}</a></span>
							<span><strong class="text-slate-900">Modalidad:</strong> A definir segun la propuesta</span>
						</div>
					</div>

					<div class="lg:col-span-5">
						<div class="bg-white rounded-2xl border border-slate-200 shadow-xl p-6 sm:p-8">
							<p class="text-xs font-semibold text-cyan-700 uppercase tracking-wider mb-4">Resumen rapido</p>
							<div class="grid grid-cols-2 gap-4 mb-6">
								<div class="rounded-xl bg-slate-50 border border-slate-200 p-4">
									<p class="text-xs text-slate-500 uppercase tracking-wide mb-1">Caminos</p>
									<p class="text-lg font-bold text-slate-900">3 lineas</p>
								</div>
								<div class="rounded-xl bg-slate-50 border border-slate-200 p-4">
									<p class="text-xs text-slate-500 uppercase tracking-wide mb-1">Publico</p>
									<p class="text-sm font-semibold text-slate-900">Estudiantes y egresados con interes tecnico</p>
								</div>
								<div class="rounded-xl bg-slate-50 border border-slate-200 p-4 col-span-2">
									<p class="text-xs text-slate-500 uppercase tracking-wide mb-1">Estado</p>
									<p class="text-lg font-bold text-emerald-700">Se coordina caso por caso</p>
								</div>
							</div>

							<div class="space-y-4 text-sm text-slate-600">
								<div>
									<p class="font-semibold text-slate-900 mb-1">Contacto previo</p>
									<a href={`mailto:${oportunidad.contacto}`} class="text-blue-700 hover:underline font-mono break-all">{oportunidad.contacto}</a>
								</div>
								<div>
									<p class="font-semibold text-slate-900 mb-1">Seguimiento</p>
									<p class="text-slate-600">Si la propuesta encaja, coordinamos una charla breve para ver alternativas.</p>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<section class="py-16 bg-white">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="max-w-3xl mb-10">
					<p class="text-sm font-semibold text-cyan-700 uppercase tracking-wider mb-3">Que se busca</p>
					<h2 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-4">Tres caminos de entrada al laboratorio</h2>
					<p class="text-slate-600 leading-relaxed">
						La idea es que la persona interesada encuentre una modalidad concreta y viable para vincularse con el LED&T.
						Pueden ser proyectos integradores, adscripciones, tesis o una colaboracion puntual que se acuerde con el equipo.
					</p>
				</div>

				<div class="grid lg:grid-cols-3 gap-6">
					{lineas.map((posicion) => (
						<article class="rounded-2xl border border-slate-200 bg-slate-50 p-6 shadow-sm">
							<p class="text-xs font-semibold text-cyan-700 uppercase tracking-wider mb-2">Linea abierta</p>
							<h3 class="text-2xl font-bold text-slate-900 mb-3">{posicion.nombre}</h3>
							<p class="text-slate-600 leading-relaxed mb-4">{posicion.resumen}</p>
							<p class="text-sm text-slate-800 font-medium mb-4">{posicion.perfil}</p>
							<ul class="space-y-2 text-sm text-slate-600">
								{posicion.items.map((item) => (
									<li class="flex items-start gap-2">
										<span class="mt-2 w-1.5 h-1.5 rounded-full bg-blue-600 shrink-0"></span>
										<span>{item}</span>
									</li>
								))}
							</ul>
						</article>
					))}
				</div>
			</div>
		</section>

		<section class="py-16 bg-slate-50 border-y border-slate-200">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid lg:grid-cols-12 gap-8">
				<div class="lg:col-span-7">
					<p class="text-sm font-semibold text-cyan-700 uppercase tracking-wider mb-3">Infraestructura</p>
						<h2 class="text-3xl font-bold text-slate-900 mb-5">Herramientas y entorno de trabajo</h2>
					<div class="grid sm:grid-cols-2 gap-4">
						{herramientas.map((herramienta) => (
							<div class="bg-white border border-slate-200 rounded-xl p-4 text-sm text-slate-700 leading-relaxed">
								{herramienta}
							</div>
						))}
					</div>
				</div>

				<div class="lg:col-span-5">
					<div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm h-full">
						<p class="text-sm font-semibold text-cyan-700 uppercase tracking-wider mb-3">Por que vale la pena</p>
						<h2 class="text-2xl font-bold text-slate-900 mb-5">Lo que gana quien se suma</h2>
						<ul class="space-y-3 text-sm text-slate-600">
							{beneficios.map((beneficio) => (
								<li class="flex items-start gap-3">
									<span class="mt-1.5 w-2 h-2 rounded-full bg-emerald-500 shrink-0"></span>
									<span>{beneficio}</span>
								</li>
							))}
						</ul>
					</div>
				</div>
			</div>
		</section>

		<section class="py-16 bg-white">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid lg:grid-cols-12 gap-8">
				<div class="lg:col-span-5">
					<p class="text-sm font-semibold text-cyan-700 uppercase tracking-wider mb-3">Equipo anfitrion</p>
						<h2 class="text-3xl font-bold text-slate-900 mb-4">Acompanamiento tecnico directo dentro del laboratorio</h2>
					<p class="text-slate-600 leading-relaxed">
							Las propuestas se revisan con docentes-investigadores del LED&T para encontrar el mejor encaje segun el perfil,
							la disponibilidad y el nivel de experiencia. La idea no es trabajar aislado, sino integrarse a una mesa
							tecnica con seguimiento real.
					</p>
				</div>

				<div class="lg:col-span-7 grid md:grid-cols-3 gap-4">
					{equipo.map((persona) => (
						<article class="rounded-2xl border border-slate-200 bg-slate-50 p-5">
							<p class="text-xs font-semibold text-cyan-700 uppercase tracking-wider mb-2">{persona.rol}</p>
							<h3 class="text-lg font-bold text-slate-900 mb-3">{persona.nombre}</h3>
							<p class="text-sm text-slate-600 leading-relaxed">{persona.expertise}</p>
						</article>
					))}
				</div>
			</div>
		</section>

		<section class="py-16 bg-linear-to-br from-blue-900 via-blue-800 to-slate-900 text-white">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid lg:grid-cols-12 gap-8 items-start">
				<div class="lg:col-span-7">
					<p class="text-sm font-semibold text-cyan-300 uppercase tracking-wider mb-3">Como postularse</p>
						<h2 class="text-3xl sm:text-4xl font-bold mb-5">Como seguimos una consulta</h2>
					<div class="space-y-4">
							{pasos.map((item) => (
							<div class="rounded-2xl border border-white/15 bg-white/5 backdrop-blur-sm p-5">
								<h3 class="text-lg font-bold mb-2">{item.paso}</h3>
								<p class="text-blue-100 leading-relaxed">{item.detalle}</p>
							</div>
						))}
					</div>
				</div>

				<div class="lg:col-span-5">
					<div class="rounded-2xl border border-white/15 bg-white/10 backdrop-blur-sm p-6 shadow-xl">
						<p class="text-xs font-semibold text-cyan-300 uppercase tracking-wider mb-3">Checklist minimo</p>
						<ul class="space-y-3 text-sm text-blue-100 mb-6">
								<li>Breve presentacion de tu interes y tu carrera.</li>
								<li>Que tipo de experiencia estas buscando.</li>
								<li>Disponibilidad aproximada para sumarte.</li>
								<li>Un medio de contacto para coordinar la respuesta.</li>
						</ul>
						<div class="space-y-3">
								<a href={`mailto:${oportunidad.contacto}?subject=Consulta%20de%20oportunidades%20-%20LED%26T`} class="w-full inline-flex justify-center items-center gap-2 px-5 py-3 bg-white text-blue-900 font-semibold rounded-lg hover:bg-slate-100 transition-colors">
									Enviar consulta
								</a>
								<a href="/contacto" class="w-full inline-flex justify-center items-center gap-2 px-5 py-3 border border-white/30 text-white font-semibold rounded-lg hover:bg-white/10 transition-colors">
									Ver contacto general
							</a>
						</div>
					</div>
				</div>
			</div>
		</section>
	</main>
</Layout>
