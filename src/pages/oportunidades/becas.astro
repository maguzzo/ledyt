---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Oportunidades | LED&T">
	<main class="min-h-[65vh] bg-slate-50">
		<section class="bg-linear-to-br from-slate-50 via-white to-cyan-50/40 border-b border-slate-200 py-16 md:py-24">
			<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
				<p class="text-sm font-semibold text-cyan-700 uppercase tracking-widest mb-4">Oportunidades abiertas</p>
				<h1 class="text-3xl md:text-5xl font-bold text-slate-900 mb-6">Consultas y alternativas para sumarte al LED&T</h1>
				<p class="text-slate-600 text-lg leading-relaxed mb-8 max-w-3xl">
					Esta pagina centraliza consultas generales sobre proyectos integradores, adscripciones, tesis y otras formas de colaboracion.
					Si te interesa conversar una alternativa, escribinos y vemos qué encaja mejor con tu perfil y disponibilidad.
				</p>
				<div class="flex flex-wrap gap-3">
					<a href="/oportunidades" class="inline-flex items-center gap-2 px-5 py-3 rounded-lg bg-blue-700 text-white font-semibold hover:bg-blue-800 transition-colors">
						Ver oportunidades
					</a>
					<a href="/contacto" class="inline-flex items-center gap-2 px-5 py-3 rounded-lg border border-slate-300 text-slate-800 font-semibold hover:bg-slate-100 transition-colors">
						Ir a contacto
					</a>
				</div>
			</div>
		</section>
	</main>
</Layout>
