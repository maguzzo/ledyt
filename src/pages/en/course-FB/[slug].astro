---
import Layout from '../../../layouts/Layout.astro';

export function getStaticPaths() {
	return [{ params: { slug: 'optical-fiber-networks-course' } }];
}

const { slug = 'news-item' } = Astro.params;
const titleText = slug
	.split('-')
	.filter(Boolean)
	.map((p) => p.charAt(0).toUpperCase() + p.slice(1))
	.join(' ');
---

<Layout title={`${titleText} | LED&T`}>
	<main class="min-h-[65vh] bg-fondo">
		<section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
			<p class="text-acento font-mono text-sm uppercase tracking-widest mb-4">Open registration</p>
			<h1 class="text-3xl md:text-5xl font-bold text-texto mb-6">Optical Fiber Networks: Installation and Maintenance</h1>
			<p class="text-texto-suave text-lg leading-relaxed mb-8">Read the full course announcement and contact us to request pre-registration.</p>
			<a href="/en/news" class="inline-flex items-center px-5 py-3 rounded-md bg-primario text-white font-semibold hover:bg-primario-oscuro transition-colors">Read full announcement</a>
		</section>
	</main>
</Layout>
