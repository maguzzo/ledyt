---
import Layout from '../../../layouts/Layout.astro';
---

<Layout title="Opportunities | LED&T">
	<main class="min-h-[65vh] bg-fondo">
		<section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
			<p class="text-acento font-mono text-sm uppercase tracking-widest mb-4">Opportunities</p>
			<h1 class="text-3xl md:text-5xl font-bold text-texto mb-6">Ways to join the LED&T</h1>
			<p class="text-texto-suave text-lg leading-relaxed mb-8 max-w-3xl">
				This page now gathers general opportunities for integrative projects, assistantships, theses, and other collaborations.
				If you want to discuss an alternative, write to us and we will review what fits best.
			</p>
			<a href="/en/opportunities" class="inline-flex items-center gap-2 px-5 py-3 rounded-md bg-primario text-white font-semibold hover:bg-primario-oscuro transition-colors">
				Back to opportunities
			</a>
		</section>
	</main>
</Layout>
