---
import Layout from '../../layouts/Layout.astro';

const featuredProjects = [
	{
		slug: 'chalu-x',
		name: 'CHALU-X',
		category: 'CUBESAT · COMMUNICATIONS',
		partners: 'UNSJ PDTS + IAR',
		description: 'Dual-band (S/UHF) satellite modem for CubeSats. DVB-S2 Short Frame compliant over Zynq + AD9364, with independent TTC on MSP430. Communications subsystem for CHAZE-Agro.',
		status: 'active',
		statusLabel: 'Active',
		image: '/images/projects/chalu-x/arquero-huarpe.webp',
		imageAlt: 'CHALU-X project artwork showing a Huarpe archer',
		href: '/en/projects/chalu-x'
	},
	{
		slug: 'chaze-agro',
		name: 'CHAZE-Agro',
		category: 'SATELLITE · AGRICULTURE',
		partners: 'UNSJ + INTA + CONAE',
		description: 'Cooperative satellite mission with Sony IMX454 hyperspectral sensor (41 bands) over Zynq-7020 FPGA. Subsystems named in the Huarpe language: YOTO, NEU, CHALU-X, HIERNEN.',
		status: 'evaluation',
		statusLabel: 'Under evaluation',
		image: '/images/projects/chaze-agro/chaze-agro-collage.webp',
		imageAlt: 'CHAZE-Agro for satellite precision agriculture',
		href: '/en/projects/chaze-agro'
	},
	{
		slug: 'sat-pae-jachal',
		name: 'SAT-PAE Jachal',
		category: 'WATER MONITORING',
		partners: 'UNSJ + UCC + CJyP + San Juan Government',
		description: '20 early-warning stations for the Jachal River Basin. YSI EXO2 probes, bbe biosensors, Starlink/Iridium telemetry, and custom SCADA. USD 11.94M.',
		status: 'evaluation',
		statusLabel: 'Under evaluation',
		image: '/images/projects/rio-san-juan/gabinete-estacion.webp',
		imageAlt: 'Field water-monitoring station',
		href: '/en/projects/sat-pae-jachal'
	},
	{
		slug: 'cart',
		name: 'CART Backend',
		category: 'RADIO ASTRONOMY',
		partners: 'UNSJ + IAR',
		description: 'Digital signal processing for the Argentine-Chinese Radio Telescope in San Juan. RFSoC FPGA processing for radio astronomy observations. Successfully completed.',
		status: 'completed',
		statusLabel: 'Completed · 2024',
		image: '/images/capabilities/rfsoc-dual-placas.webp',
		imageAlt: 'RFSoC boards for radio astronomy signal processing',
		href: '/en/projects/backend-digital-cart'
	}
];

const capabilities = [
	{ icon: '⚡', title: 'FPGA & RFSoC', detail: 'Zynq · UltraScale+' },
	{ icon: '📡', title: 'SDR', detail: 'ADALM-Pluto · USRP' },
	{ icon: '🛰', title: 'Satellite communications', detail: 'DVB-S2 · CSP' },
	{ icon: '🌐', title: 'IoT', detail: 'LoRa · ZigBee · WiFi' },
	{ icon: '🔬', title: 'RFI measurements', detail: 'Aaronia · Spectrum' },
	{ icon: '🔌', title: 'Embedded systems', detail: 'C/C++ · Python · Linux' },
	{ icon: '🛠', title: 'PCB prototyping', detail: 'Altium · Flux.ai' },
	{ icon: '💎', title: 'Optical fiber', detail: 'Diploma · R&D' },
];

type Opportunity = {
	icon: string;
	title: string;
	description: string;
	href: string;
	featured?: boolean;
};

const opportunities: Opportunity[] = [
	{ icon: '🎓', title: 'Integrative Projects', description: 'For students currently enrolled in PI 1, 2, or 3.', href: '/en/opportunities/integrative-projects' },
	{ icon: '📋', title: 'Research assistantships', description: 'Build real experience for your CV.', href: '/en/opportunities/research-assistantships' },
	{ icon: '📌', title: 'Open opportunities', description: 'Integrative projects, assistantships, and theses.', href: '/en/opportunities' },
	{ icon: '🔬', title: 'Theses and final projects', description: 'For in-depth research work.', href: '/en/opportunities/theses' },
];

const partners = [
	{ name: 'IAR', href: 'https://www.iar.unlp.edu.ar/' },
	{ name: 'CONAE', href: 'https://www.argentina.gob.ar/ciencia/conae' },
	{ name: 'INTA', href: 'https://www.argentina.gob.ar/inta/cr-mendoza-sanjuan/eea-sanjuan' },
	{ name: 'SECyTI', href: 'https://ciencia.sanjuan.gob.ar/' },
	{ name: 'INBIO', href: 'https://inbio.fi.unsj.edu.ar/' },
	{ name: 'INAUT', href: 'http://www.inaut.unsj.edu.ar/' },
	{ name: 'IDECOM', href: 'https://www.idecom.unsj.edu.ar/' },
];

function badgeClass(status: string) {
	switch (status) {
		case 'active': return 'bg-emerald-100 text-emerald-800 border-emerald-300';
		case 'evaluation': return 'bg-amber-100 text-amber-800 border-amber-300';
		case 'upcoming': return 'bg-blue-100 text-blue-800 border-blue-300';
		case 'completed': return 'bg-slate-200 text-slate-700 border-slate-300';
		default: return 'bg-slate-100 text-slate-700 border-slate-300';
	}
}
---

<Layout title="LED&T - Digital Electronics and Telecommunications Lab | UNSJ">

	<section class="relative overflow-hidden bg-linear-to-br from-slate-50 via-white to-cyan-50/40">
		<div class="absolute top-0 right-0 w-96 h-96 bg-cyan-100/30 rounded-full blur-3xl z-0"></div>
		<div class="absolute bottom-0 left-0 w-80 h-80 bg-blue-100/30 rounded-full blur-3xl z-0"></div>

		<div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
			<div class="grid lg:grid-cols-12 gap-8 lg:gap-12 items-center">
				<div class="lg:col-span-7 order-2 lg:order-1">
					<p class="inline-flex items-center gap-2 text-sm font-semibold text-cyan-700 mb-5 tracking-wide">
						<span class="w-8 h-px bg-cyan-600"></span>
						NATIONAL UNIVERSITY OF SAN JUAN · SINCE 1973
					</p>
					<h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-slate-900 leading-[1.1] mb-6">
						From microprocessors to satellites:<br/>
						<span class="text-blue-700">53 years</span> of engineering in San Juan
					</h1>
					<p class="text-lg text-slate-600 mb-8 max-w-2xl leading-relaxed">
						Digital Electronics and Telecommunications Lab. Research, development, and services in reconfigurable digital systems, radio astronomy, satellites, and advanced telecommunications.
					</p>
					<div class="flex flex-wrap gap-3">
						<a href="/en/projects" class="inline-flex items-center gap-2 px-6 py-3 bg-red-600 text-white font-semibold rounded-lg hover:bg-red-700 transition-colors shadow-md">
							View projects
							<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
						</a>
						<a href="/en/services" class="inline-flex items-center gap-2 px-6 py-3 border-2 border-blue-700 text-blue-700 font-semibold rounded-lg hover:bg-blue-700 hover:text-white transition-colors">
							Industry services
						</a>
					</div>
				</div>

				<div class="lg:col-span-5 order-1 lg:order-2 flex justify-center">
					<div class="relative max-w-sm lg:max-w-md">
						<picture>
							<source srcset="/images/projects/chalu-x/arquero-huarpe-mobile.webp" media="(max-width: 640px)" type="image/webp" />
							<source srcset="/images/projects/chalu-x/arquero-huarpe-tablet.webp" type="image/webp" />
							<img
								src="/images/projects/chalu-x/arquero-huarpe.png"
								alt="Huarpe archer from the CHALU-X project. Illustration by Dr. Martin Guzzo, 2025."
								class="w-full h-auto drop-shadow-2xl rounded-lg"
								loading="eager"
							/>
						</picture>
						<p class="text-xs text-slate-500 italic text-center mt-3 px-2 leading-relaxed">
							<strong class="text-slate-700">Chalu</strong>: "arrow" in Allentiac, language of the Huarpe people of San Juan.
							<br/><span class="text-slate-400">Illustration: Dr. Martin Guzzo, 2025.</span>
						</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<a href="https://www.fi.unsj.edu.ar/noticias/noticia/1139/el-observatorio-internacional-heron-arribo-a-la-facultad-de-ingenieria-para-articular-una-factible-instalacion-de-un-observatorio-de-neutrinos" target="_blank" rel="noopener noreferrer" class="block bg-slate-900 text-white py-6 border-y-4 border-cyan-500 hover:bg-slate-800 transition-colors group">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="flex flex-col md:flex-row items-center gap-4 md:gap-6">
				<div class="flex items-center gap-4 shrink-0">
					<div class="w-16 h-16 rounded-lg overflow-hidden shrink-0">
						<img src="/images/projects/heron/heron-logo.png" alt="HERON" class="w-full h-full object-cover" />
					</div>
					<div>
						<p class="text-xs font-semibold text-cyan-400 uppercase tracking-wider">Coming soon</p>
						<p class="text-lg font-bold leading-tight">HERON</p>
					</div>
				</div>
				<div class="flex-1 text-sm md:text-base text-slate-200 leading-relaxed text-center md:text-left">
					<strong class="text-white">Hybrid Elevated Radio Observatory for Neutrinos.</strong>
					International cosmic-neutrino observatory funded by ERC. Dr. Martin A. Guzzo, member of LED&T-UNSJ, was selected as the Argentinian Site Manager. Agreements are in progress, signature expected in 2026.
				</div>
				<div class="shrink-0 text-cyan-400 group-hover:translate-x-1 transition-transform">
					<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
				</div>
			</div>
		</div>
	</a>

	<section id="quienes-somos" class="py-20 bg-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
				<div>
					<h2 class="text-sm font-semibold text-cyan-700 uppercase tracking-wider mb-3">Who we are</h2>
					<h3 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-6 leading-tight">
						Pioneers in digital systems and telecommunications
					</h3>
					<div class="space-y-4 text-slate-600 leading-relaxed">
						<p>
							LED&T is a center of excellence within the <strong class="text-slate-900">Department of Electronics and Automatic Control (DEA)</strong> at UNSJ Faculty of Engineering. Since 1973, we have pioneered research and development in digital systems and telecommunications.
						</p>
						<p>
							Our multidisciplinary team of faculty researchers specializes in reconfigurable digital systems, the Internet of Things (IoT), and advanced telecommunications technologies. We collaborate with CONAE, CONICET, INTA, IAR, and private industry.
						</p>
					</div>
					<div class="mt-8 grid grid-cols-3 gap-4 text-center">
						<div class="p-4 bg-slate-50 rounded-lg">
							<div class="text-3xl font-bold text-blue-700">53</div>
							<div class="text-xs text-slate-600 mt-1">years of trajectory</div>
						</div>
						<div class="p-4 bg-slate-50 rounded-lg">
							<div class="text-3xl font-bold text-blue-700">+10</div>
							<div class="text-xs text-slate-600 mt-1">active projects</div>
						</div>
						<div class="p-4 bg-slate-50 rounded-lg">
							<div class="text-3xl font-bold text-blue-700">8</div>
							<div class="text-xs text-slate-600 mt-1">technical areas</div>
						</div>
					</div>
				</div>
				<div class="relative">
					<picture>
						<source srcset="/images/lab/curso-fibra-optica.webp" type="image/webp" />
						<img
							src="/images/lab/curso-fibra-optica.jpg"
							alt="Optical fiber course at LED&T"
							class="w-full h-auto rounded-2xl shadow-2xl"
							loading="lazy"
						/>
					</picture>
					<div class="absolute -bottom-4 -left-4 bg-blue-700 text-white px-5 py-3 rounded-lg shadow-xl text-sm font-semibold hidden sm:block">
						Optical fiber course · LED&T
					</div>
				</div>
			</div>
		</div>
	</section>

	<section id="capacidades" class="py-20 bg-slate-50">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="text-center max-w-2xl mx-auto mb-12">
				<h2 class="text-sm font-semibold text-cyan-700 uppercase tracking-wider mb-3">Featured projects</h2>
				<h3 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-4">
					Research that makes impact
				</h3>
				<p class="text-slate-600 leading-relaxed">
					From radio astronomy to precision agriculture, we bring Argentinian technology to the frontier of knowledge.
				</p>
			</div>

			<div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
				{featuredProjects.map((project) => (
					<a href={project.href} class="group bg-white rounded-2xl overflow-hidden shadow-md hover:shadow-2xl transition-all duration-300 border border-slate-200 flex flex-col">
						<div class="relative aspect-4/3 overflow-hidden bg-slate-100">
							<img
								src={project.image}
								alt={project.imageAlt}
								class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
								loading="lazy"
							/>
							<div class="absolute top-3 left-3">
								<span class={`inline-block px-3 py-1 text-xs font-bold rounded-full border ${badgeClass(project.status)}`}>
									{project.statusLabel}
								</span>
							</div>
						</div>
						<div class="p-5 flex-1 flex flex-col">
							<p class="text-xs font-semibold text-cyan-700 uppercase tracking-wider mb-1">
								{project.category}
							</p>
							<h4 class="text-xl font-bold text-slate-900 mb-2 group-hover:text-blue-700 transition-colors">
								{project.name}
							</h4>
							<p class="text-xs text-slate-500 mb-3 font-medium">
								{project.partners}
							</p>
							<p class="text-sm text-slate-600 leading-relaxed flex-1">
								{project.description}
							</p>
							<div class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-blue-700 group-hover:gap-2 transition-all">
								View project
								<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
							</div>
						</div>
					</a>
				))}
			</div>

			<div class="text-center mt-10">
				<a href="/en/projects" class="inline-flex items-center gap-2 text-blue-700 font-semibold hover:gap-3 transition-all">
					View all projects (including historical trajectory)
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
				</a>
			</div>
		</div>
	</section>

	<section id="technical-capabilities" class="py-20 bg-white relative overflow-hidden">
		<div class="absolute top-0 right-0 w-1/3 h-full opacity-5 hidden lg:block">
			<img src="/images/capabilities/rfsoc-rtx-setup.jpg" alt="" class="w-full h-full object-cover" />
		</div>

		<div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="text-center max-w-2xl mx-auto mb-12">
				<h2 class="text-sm font-semibold text-cyan-700 uppercase tracking-wider mb-3">Technical capabilities</h2>
				<h3 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-4">
					From idea to functional prototype
				</h3>
				<p class="text-slate-600 leading-relaxed">
					Capabilities validated in projects for CONAE, CONICET, INTA, IAR, and private companies. R&D and consulting services available.
				</p>
			</div>

			<div class="grid grid-cols-2 md:grid-cols-4 gap-4">
				{capabilities.map((capability) => (
					<div class="p-6 bg-slate-50 hover:bg-blue-50 rounded-xl text-center transition-colors border border-slate-100 hover:border-blue-200">
						<div class="text-4xl mb-3">{capability.icon}</div>
						<h4 class="font-bold text-slate-900 mb-1">{capability.title}</h4>
						<p class="text-xs text-slate-500">{capability.detail}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<section id="opportunities" class="py-20 bg-linear-to-br from-blue-900 via-blue-800 to-slate-900 text-white relative overflow-hidden">
		<div class="absolute inset-0 opacity-5">
			<div class="absolute top-0 left-0 w-96 h-96 bg-cyan-400 rounded-full blur-3xl"></div>
			<div class="absolute bottom-0 right-0 w-96 h-96 bg-red-500 rounded-full blur-3xl"></div>
		</div>

		<div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="text-center max-w-2xl mx-auto mb-12">
				<h2 class="text-sm font-semibold text-cyan-300 uppercase tracking-wider mb-3">Join the team</h2>
				<h3 class="text-3xl sm:text-4xl font-bold mb-4">
					Your career starts here
				</h3>
				<p class="text-blue-100 leading-relaxed">
					Four pathways to become part of LED&T, depending on your stage and goals.
				</p>
			</div>

			<div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
				{opportunities.map((opportunity) => (
					<a href={opportunity.href} class={`block p-6 rounded-xl transition-all hover:scale-105 ${opportunity.featured ? 'bg-red-600 hover:bg-red-700' : 'bg-white/10 hover:bg-white/20 backdrop-blur-sm border border-white/10'}`}>
						<div class="text-4xl mb-3">{opportunity.icon}</div>
						<h4 class="font-bold text-lg mb-2">{opportunity.title}</h4>
						<p class="text-sm text-blue-100 leading-relaxed">{opportunity.description}</p>
						{opportunity.featured && (
							<span class="inline-block mt-3 text-xs font-bold uppercase tracking-wider bg-white/20 px-2 py-1 rounded">Active</span>
						)}
					</a>
				))}
			</div>
		</div>
	</section>

	<section class="py-12 bg-slate-100 border-y border-slate-200">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<p class="text-center text-sm font-semibold text-slate-500 uppercase tracking-wider mb-6">
				We collaborate with
			</p>
			<div class="flex flex-wrap justify-center items-center gap-x-8 gap-y-4 text-slate-600 font-semibold text-sm md:text-base">
				{partners.map((partner) => (
					<a
						href={partner.href}
						target="_blank"
						rel="noopener noreferrer"
						class="hover:text-blue-700 transition-colors"
					>
						{partner.name}
					</a>
				))}
			</div>
		</div>
	</section>

	<footer id="contacto" class="bg-slate-900 text-white pt-16 pb-8">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8 md:gap-12 mb-12">

				<div class="lg:col-span-1">
					<img src="/images/logos/logo-main-dark.png" alt="LED&T" class="h-12 w-auto mb-4" onerror="this.src='/images/logos/logo-main.png'" />
					<p class="text-sm text-slate-400 leading-relaxed">
						Digital Electronics and Telecommunications Lab. Department of Electronics and Automatic Control, Faculty of Engineering, UNSJ.
					</p>
					<p class="text-xs text-cyan-400 mt-3 font-semibold">Since 1973</p>
				</div>

				<div>
					<h3 class="font-bold mb-4 text-cyan-300">Contact</h3>
					<ul class="space-y-3 text-slate-300 text-sm">
						<li>
							<span class="text-slate-500 block mb-1 text-xs uppercase tracking-wider">Address</span>
							Av. Lib. Gral. San Martin 1109 (O)<br/>
							J5400ARL · San Juan, Argentina
						</li>
						<li>
							<span class="text-slate-500 block mb-1 text-xs uppercase tracking-wider">Institutional email</span>
							<a href="mailto:sec_dea@unsj.edu.ar" class="hover:text-cyan-300 transition-colors font-mono break-all">
								sec_dea@unsj.edu.ar
							</a>
							<p class="text-slate-500 text-xs mt-1">DEA Secretariat</p>
						</li>
						<li>
							<span class="text-slate-500 block mb-1 text-xs uppercase tracking-wider">Phone</span>
							<a href="tel:+542644211700" class="hover:text-cyan-300 transition-colors font-mono">
								+54 264 421-1700
							</a>
							<div class="mt-2 grid grid-cols-2 gap-x-4 gap-y-1 text-xs">
								<span class="text-slate-500">Ext. 4380</span>
								<span>Common area</span>
								<span class="text-slate-500">Ext. 4381</span>
								<span>LED Office</span>
								<span class="text-slate-500">Ext. 4383</span>
								<span>Directorate</span>
								<span class="text-slate-500">Ext. 4386</span>
								<span>Telecommunications</span>
							</div>
						</li>
					</ul>
				</div>

				<div>
					<h3 class="font-bold mb-4 text-cyan-300">Directorate</h3>
					<p class="text-slate-200 font-semibold mb-1">To be defined</p>
					<p class="text-slate-500 text-xs mb-3">Position subject to internal election</p>
					<p class="text-slate-500 text-xs mt-3 leading-relaxed">
						Until official appointment, institutional requests are handled through DEA Secretariat.
					</p>
				</div>

				<div>
					<h3 class="font-bold mb-4 text-cyan-300">Links</h3>
					<ul class="space-y-2 text-sm">
						<li><a href="/en/about" class="text-slate-300 hover:text-cyan-300 transition-colors">About LED&T</a></li>
						<li><a href="https://dea.unsj.edu.ar" target="_blank" rel="noopener" class="text-slate-300 hover:text-cyan-300 transition-colors">DEA</a></li>
						<li><a href="https://www.fi.unsj.edu.ar" target="_blank" rel="noopener" class="text-slate-300 hover:text-cyan-300 transition-colors">FI-UNSJ</a></li>
