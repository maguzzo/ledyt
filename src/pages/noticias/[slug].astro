---
// NOTE: Direct routing is now implemented in the news list.
// Links now point directly to final destinations (/curso-FB and /noticias/estancia-investigacion-iar)
// These redirects are maintained for backwards compatibility with old bookmarks/links

export function getStaticPaths() {
	return [
		{ params: { slug: 'curso-fibra-optica' } },
		{ params: { slug: 'estancia-iar' } },
	];
}

const destinos: Record<string, string> = {
	'curso-fibra-optica': '/curso-FB',
	'estancia-iar': '/noticias/estancia-investigacion-iar',
};
const destino = destinos[Astro.params.slug ?? ''];
if (destino) {
	return Astro.redirect(destino);
}
