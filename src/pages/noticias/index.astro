---
import Layout from '../../layouts/Layout.astro';

const noticias = [
	{
		titulo: 'Curso de extension de fibra optica',
		categoria: 'Inscripciones abiertas',
		extracto: 'Nueva propuesta de formacion practica en instalacion y mantenimiento de redes de fibra optica en la UNSJ.',
		imagen: '/images/noticias/flyer-fibra.jpeg',
		alt: 'Flyer del curso de extension Redes de Fibra Optica',
		href: '/curso-FB',
		agotada: true,
		estado: 'Cupos agotados hasta el siguiente año',
	},
	{
		titulo: 'Estancia de investigacion en el Instituto Argentino de Radioastronomia (IAR)',
		categoria: 'Investigacion · IAR · UNSJ',
		extracto: 'Una colaboracion cientifico-tecnologica para avanzar en el desarrollo del modulo de comunicaciones CHALU-X para satelites CubeSat.',
		imagen: '/images/noticias/noticia-super-antena.jpeg',
		alt: 'Antena principal del Instituto Argentino de Radioastronomia',
		href: '/noticias/estancia-investigacion-iar',
	},
];
---

<Layout title="Noticias | LED&T">
	<main class="min-h-screen bg-fondo">
		<section class="border-b border-borde bg-fondo-alt">
			<div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 md:py-20 lg:px-8">
				<p class="mb-4 font-mono text-sm uppercase tracking-[0.2em] text-acento">LED&amp;T · Actualidad</p>
				<h1 class="max-w-3xl text-4xl font-bold leading-tight text-texto md:text-6xl">Noticias</h1>
				<p class="mt-5 max-w-2xl text-lg leading-relaxed text-texto-suave">Investigacion, formacion y proyectos que conectan al laboratorio con la comunidad.</p>
			</div>
		</section>

		<section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 md:py-16 lg:px-8">
			<div class="grid gap-7 md:grid-cols-2">
				{noticias.map((noticia) => (
					<a href={noticia.href} class:list={[
						'group relative flex h-full flex-col overflow-hidden rounded-lg border bg-fondo-elevado shadow-card transition duration-200 focus-visible:-translate-y-1',
						noticia.agotada ? 'border-slate-300 bg-slate-100' : 'border-borde hover:-translate-y-1 hover:shadow-card-hover',
					]}>
						{noticia.agotada && <span class="absolute left-4 top-4 z-10 max-w-[calc(100%-2rem)] rounded-md bg-red-600 px-3 py-2 text-center text-xs font-bold leading-tight text-white shadow-md">{noticia.estado}</span>}
						<div class:list={['aspect-[16/9] overflow-hidden bg-fondo-alt', noticia.agotada && 'grayscale opacity-75']}>
							<img src={noticia.imagen} alt={noticia.alt} class="h-full w-full object-cover transition duration-500 group-hover:scale-105" loading="lazy" />
						</div>
						<div class:list={['flex flex-1 flex-col p-6 md:p-7', noticia.agotada && 'text-slate-500']}>
							<p class:list={['mb-3 font-mono text-xs uppercase tracking-widest', noticia.agotada ? 'text-slate-500' : 'text-acento']}>{noticia.categoria}</p>
							<h2 class:list={['text-2xl font-bold leading-tight', noticia.agotada ? 'text-slate-600' : 'text-texto group-hover:text-primario']}>{noticia.titulo}</h2>
							<p class="mt-4 flex-1 leading-relaxed text-texto-suave">{noticia.extracto}</p>
							<span class:list={['mt-7 inline-flex items-center gap-2 font-semibold', noticia.agotada ? 'text-slate-500' : 'text-primario']}>Leer noticia <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">-&gt;</span></span>
						</div>
					</a>
				))}
			</div>
		</section>
	</main>
</Layout>
